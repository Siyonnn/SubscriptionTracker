# Copy this file to .env and fill in the values from
# Firebase Console > Project settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed for payment reminders. From Project settings > Cloud Messaging >
# Web configuration > Web Push certificates. Leave blank to hide the reminders button.
VITE_FIREBASE_VAPID_KEY=
